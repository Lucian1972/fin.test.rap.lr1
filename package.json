{
    "name": "fin.test.rap.lr1",
    "version": "0.0.1",
    "description": "",
    "devDependencies": {
        "@sap-ux/eslint-plugin-fiori-tools": "^9.13.0",
        "@sap/ui5-builder-webide-extension": "1.0.x",
        "@sap/ux-ui5-tooling": "^1.23.0",
        "@ui5/cli": "^4.0.38",
        "eslint": "^9",
        "rimraf": "3.0.2"
    },
    "scripts": {
        "start": "fiori run --open \"test/flpSandbox.html?sap-client=900&sap-ui-xx-viewCache=false#Travel-display\"",
        "start-local": "fiori run --config ./ui5-local.yaml --open \"test/flpSandboxMockServer.html?sap-client=900&sap-ui-xx-viewCache=false#masterDetail-display\"",
        "start-noflp": "fiori run --open \"index.html?sap-client=900&sap-ui-xx-viewCache=false\"",
        "start-variants-management": "fiori run --open \"preview.html?sap-client=900&sap-ui-xx-viewCache=false&fiori-tools-rta-mode=true&sap-ui-rta-skip-flex-validation=true#preview-app\"",
        "build": "ui5 build -a --clean-dest --include-task=generateManifestBundle generateCachebusterInfo",
        "deploy": "fiori verify",
        "deploy-config": "fiori add deploy-config",
        "start-mock": "fiori run --open \"test/flpSandboxMockServer.html?sap-client=900&sap-ui-xx-viewCache=false#masterDetail-display\"",
        "start-control-property-editor": "fiori run --open 'editor.html'",
        "lint": "eslint ./"
    },
    "ui5": {
        "dependencies": [
            "@sap/ux-ui5-tooling"
        ]
    },
    "private": true,
    "sapux": true,
    "sapuxLayer": "VENDOR",
    "keywords": [
        "ui5",
        "openui5",
        "sapui5"
    ],
    "main": "webapp/index.html"
}
